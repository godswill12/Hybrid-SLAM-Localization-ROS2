<?xml version="1.0"?>
<sdf version="1.7">
  <model name="moving_box">

    <static>false</static>

    <link name="link">
      <pose>0 0 0.1 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 0.2 0.8</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>file:///ros_ws/models/gazebo_models/box_target_red/meshes/mesh.dae</uri>
            <scale>0.05 0.05 0.5</scale>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>